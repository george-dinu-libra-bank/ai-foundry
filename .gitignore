_raw_inputs/

# --- IDE ---
.idea/
.vscode/
*.iml

# --- OS ---
.DS_Store
Thumbs.db
desktop.ini

# --- Python ---
__pycache__/
*.py[cod]
.venv/
venv/
env/
.env

*.egg-info/
.ipynb_checkpoints/
.pytest_cache/
.ruff_cache/

# --- Node / JS demos ---
node_modules/
dist/
.cache/
npm-debug.log*
pnpm-debug.log*
yarn-error.log*

# --- heartbeat app runtime artifacts ---
resources/heartbeat-app/heartbeat-log.jsonl
resources/heartbeat-app/server.out

# --- Secrets / local config (never commit Azure keys or endpoints) ---
*.local
secrets.*
.azure/
local.settings.json

